<!DOCTYPE html>
<html>

<head>
<meta charset="UTF-8">
<title>System Reports</title>
</head>

<body>

<h2 align="center">System Reports</h2>

<table border="1" align="center" cellpadding="10">

<tr>
<td>Total Colleges</td>
<td>${collegeCount}</td>
</tr>

<tr>
<td>Total Companies</td>
<td>${companyCount}</td>
</tr>

<tr>
<td>Approved Companies</td>
<td>${approvedCompany}</td>
</tr>

<tr>
<td>Rejected Companies</td>
<td>${rejectedCompany}</td>
</tr>

<tr>
<td>Total Students</td>
<td>${studentCount}</td>
</tr>

<tr>
<td>Active Students</td>
<td>${activeStudent}</td>
</tr>

<tr>
<td>Inactive Students</td>
<td>${inactiveStudent}</td>
</tr>

<tr>
<td>Total Recruitment Drives</td>
<td>${driveCount}</td>
</tr>

<tr>
<td>Active Drives</td>
<td>${activeDrive}</td>
</tr>

<tr>
<td>Closed Drives</td>
<td>${closedDrive}</td>
</tr>

</table>

</body>
</html>